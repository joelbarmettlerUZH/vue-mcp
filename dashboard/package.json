{
  "name": "vue-mcp-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "bun --watch server/index.ts",
    "web": "vite --config web/vite.config.ts",
    "dev": "bun run api & bun run web",
    "build": "vite build --config web/vite.config.ts",
    "start": "bun server/index.ts",
    "test": "bun test server",
    "typecheck": "vue-tsc --noEmit -p web/tsconfig.json && bunx tsc --noEmit -p server/tsconfig.json",
    "seed": "docker compose -f ../docker-compose.dev.yml exec -T postgres psql -U vue_mcp -q -f - < seed.sql"
  },
  "dependencies": {
    "apexcharts": "8.1.0",
    "vue": "3.5.43",
    "vue3-apexcharts": "1.11.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
